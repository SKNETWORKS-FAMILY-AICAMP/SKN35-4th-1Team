# Django 백엔드 이미지. 빌드 위치는 레포 루트 (infra/docker-compose.yaml 이 지정함)
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

# 의존성만 먼저 설치해서 코드가 바뀌어도 이 층은 캐시를 쓴다.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 런타임에 분류기가 data/processed, data/mappings 를 읽는다
COPY data/processed ./data/processed
COPY data/mappings ./data/mappings
COPY backend ./backend

RUN useradd --create-home --uid 1000 app && chown -R app /app
USER app
WORKDIR /app/backend

# Django + MCP (config/asgi.py)
ENV APP_MODULE=config.asgi:application \
    WEB_CONCURRENCY=2

EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn \"$APP_MODULE\" --host 0.0.0.0 --port 8000 --workers \"$WEB_CONCURRENCY\" --proxy-headers --forwarded-allow-ips='*'"]
